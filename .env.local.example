# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Web3 / Ethereum ──
NEXT_PUBLIC_HOODLRZ_NFT_ADDRESS=0x...your-contract-address
NEXT_PUBLIC_HOODLRZ_CHAIN_ID=11155111

# ── Hoodlrz Kids · déploiement ──
#
# RÈGLE : une ADRESSE (0x + 40 car.) est publique → kids/config.json
#         une CLÉ     (0x + 64 car.) est secrète  → ici, jamais ailleurs
#
# La clé du déployeur possède les trois contrats Kids : qui l'obtient peut
# changer le renderer, vider la réserve et rediriger les royalties.
# Génère un wallet NEUF — ne réutilise pas celui du treasury CITY.
DEPLOYER_PRIVATE_KEY=0x...64-caracteres

# Destinataires (adresses publiques, doublon volontaire de kids/config.json
# pour que deploy.ts marche même si la config n'est pas à jour)
RESERVE_RECEIVER=0x...
ROYALTY_RECEIVER=0x...

# RPC Robinhood Chain — confirmé le 22/08/2026 sur docs.robinhood.com/chain
#   testnet  chain ID 46630   explorer.testnet.chain.robinhood.com
#   mainnet  chain ID  4663   robinhoodchain.blockscout.com
#
# Laisser vide utilise l'endpoint Alchemy si ALCHEMY_API_KEY est renseignée
# (fournisseur recommandé par Robinhood), sinon l'endpoint public. La doc
# dit ce dernier rate-limited et déconseillé en production : un déploiement
# pousse six transactions de 24 Ko, c'est le profil qui se fait limiter.
# Ne renseigner ces lignes que pour forcer un autre fournisseur.
RH_TESTNET_RPC=
RH_MAINNET_RPC=

# Clé Alchemy, pour prendre le snapshot des holders à un bloc précis
ALCHEMY_API_KEY=

# ───────────────────────────────────────────────────────────────────────
#  Réseau privé Hoodlrz
# ───────────────────────────────────────────────────────────────────────

# RPC Ethereum, pour vérifier la détention d'une PFP OG Hoodlrz à la
# connexion. Laisser vide utilise Alchemy si ALCHEMY_API_KEY est posée,
# sinon un endpoint public. La porte lit les deux chaînes en parallèle et
# une source en panne vaut « je ne sais pas », jamais « non ».
ETH_MAINNET_RPC=

# Secret du travail hebdomadaire des News. Sans lui la route refuse tout,
# y compris le programmateur : la collecte coûte des appels de modèle, et
# une route ouverte serait une facture et un moyen de remplir la table.
# Une valeur longue et aléatoire : openssl rand -hex 32
CRON_SECRET=

# Clé Anthropic, pour la réécriture hebdomadaire des articles. Absente,
# rien n'est publié — pas de texte de remplissage : une page vide se
# répare, un article inventé se propage.
ANTHROPIC_API_KEY=
